# Deploy on the service server:
#   1. Check out this repo to /opt/apps/catetin-prod
#   2. Copy this file to /opt/apps/catetin-prod/.env and fill secrets
#   3. mkdir -p /opt/app-data/catetin-prod/{mysql,storage,backups}
#   4. docker compose up -d --build
# compose.yml reads this file (env_file) and overrides DB_HOST=db.
APP_NAME=Catetin
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://catetin.icu

# Port published on the service server for the reverse proxy.
APP_PORT=8082

# Persistent-data root (host bind mounts). Matches /opt/app-data convention.
DATA_ROOT=/opt/app-data/catetin-prod

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pbl_sem_4
# Single credential pair on purpose: compose creates the MySQL app user from
# these same values, so they cannot drift apart (MySQL only creates users at
# first init — a second pair caused 1045 access-denied loops).
DB_APP_USER=catetin
DB_PASSWORD=change-me

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Trust Traefik forwarding headers (TLS terminates at Traefik)
TRUSTED_PROXIES=*

# If cookies break behind proxy, uncomment:
# SESSION_SECURE_COOKIE=true

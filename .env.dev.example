# Local development (containers on your laptop):
#   1. cp .env.dev.example .env.dev
#   2. Fill APP_KEY (see below) and DB_PASSWORD
#   3. docker compose -f compose.yml -f compose.dev.yml --env-file .env.dev up -d --build
#
# APP_KEY: generate once without a local PHP install via
#   docker compose -f compose.yml -f compose.dev.yml --env-file .env.dev run --rm app php artisan key:generate --show
# then paste the value here and restart the app service.
APP_NAME=Catetin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

# Host ports for local access (adjust if already in use on your machine).
APP_PORT=8082

# Hostname the BROWSER uses to reach the Vite HMR websocket.
VITE_HMR_HOST=localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pbl_sem_4
DB_USERNAME=root
DB_PASSWORD=change-me-dev

# Lightweight local drivers: no cache/session tables needed, jobs run inline.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
